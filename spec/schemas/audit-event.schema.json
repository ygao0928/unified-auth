{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unified-auth.spec/schemas/audit-event.schema.json",
  "title": "Audit Event",
  "description": "审计事件，只追加不可修改，保存不少于 6 个月。邮箱、手机号等敏感字段写入前必须脱敏；不得记录 token、密码、ticket、assertion 原文。",
  "type": "object",
  "required": ["id", "ts", "event", "actor", "result", "trace_id", "dc"],
  "properties": {
    "id": { "type": "string" },
    "ts": { "type": "string", "format": "date-time", "description": "RFC 3339，含时区与毫秒" },
    "event": {
      "type": "string",
      "enum": [
        "auth.login.success", "auth.login.failure", "auth.upstream.failure", "auth.logout",
        "session.expired", "session.kicked", "session.refresh_reused",
        "token.issued", "token.revoked", "token.exchanged",
        "authz.role.created", "authz.role.updated", "authz.role.deleted",
        "authz.user_role.granted", "authz.user_role.revoked", "authz.app_admin.changed",
        "authz.permissions.synced",
        "admin.app.created", "admin.app.updated", "admin.app.secret_rotated", "admin.app.disabled",
        "admin.idp.updated", "admin.key.rotated",
        "audit.query",
        "openapi.call"
      ]
    },
    "actor": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "type": "string", "enum": ["user", "client", "system", "anonymous"] },
        "id": { "type": "string", "description": "工号 / client_id / 系统组件名 / 尝试登录的标识" }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["user", "app", "role", "session", "app_session", "idp", "key", "permission"] },
        "id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "client_id": { "type": "string" },
    "client_type": { "type": "string", "enum": ["web", "ssr", "app", "miniapp", "m2m"] },
    "idp": { "type": "string" },
    "sid": { "type": "string" },
    "asid": { "type": "string" },
    "ip": { "type": "string" },
    "ua": { "type": "string", "maxLength": 512 },
    "result": { "type": "string", "enum": ["success", "failure"] },
    "reason": { "type": ["string", "null"], "description": "失败原因或操作原因，使用 error-codes.yaml 中的 code 或吊销 reason" },
    "changes": { "type": "object", "description": "变更类事件的前后差异（脱敏后）" },
    "trace_id": { "type": "string" },
    "dc": { "type": "string" }
  },
  "additionalProperties": false,
  "examples": [
    {
      "id": "ae_01JAX9Y",
      "ts": "2026-10-19T10:00:00.123+08:00",
      "event": "auth.login.success",
      "actor": { "type": "user", "id": "E10023" },
      "target": { "type": "app", "id": "meeting" },
      "client_id": "meeting",
      "client_type": "web",
      "idp": "corp-cas",
      "sid": "bj1.8f2c4a9e",
      "ip": "10.1.2.3",
      "ua": "...",
      "result": "success",
      "reason": null,
      "trace_id": "4bf92f3577b34da6a3ce929d0e0e4736",
      "dc": "bj1"
    }
  ]
}
